{
  "name": "angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "mocha",
    "test:e2e:headless": "cross-env E2E_HEADLESS=true npm run test:e2e",
    "test:e2e:record": "cross-env E2E_RECORD=true npm run test:e2e",
    "test:e2e:live": "bash ./e2e/run-live.sh",
    "test:e2e:presentation": "cross-env E2E_PRESENTATION=true E2E_RECORD=true E2E_HEADLESS=false mocha --no-config --timeout 300000 --require tsx/cjs --require ./e2e/support/setup.ts e2e/specs/presentation.spec.ts"
  },
  "private": true,
  "packageManager": "npm@11.0.0",
  "dependencies": {
    "@angular/common": "21.2.24",
    "@angular/compiler": "21.2.24",
    "@angular/core": "21.2.24",
    "@angular/forms": "21.2.24",
    "@angular/platform-browser": "21.2.24",
    "@angular/router": "21.2.24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ng-zorro-antd": "^21.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "21.2.24",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.3",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitest/coverage-v8": "^4.1.4",
    "chromedriver": "^154.0.0",
    "cross-env": "^7.0.3",
    "jsdom": "^28.0.0",
    "less": "^4.2.0",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "selenium-webdriver": "^4.39.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
